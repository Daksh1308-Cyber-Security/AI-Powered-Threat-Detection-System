{
  "index_templates": [
    {
      "name": "linux-logs",
      "index_patterns": ["linux-*"],
      "template": {
        "settings": {
          "number_of_shards": 1,
          "number_of_replicas": 0,
          "index.lifecycle.name": "linux-lifecycle",
          "index.lifecycle.rollover_alias": "linux"
        },
        "mappings": {
          "properties": {
            "@timestamp": { "type": "date" },
            "message": { "type": "text" },
            "agent": {
              "properties": {
                "type": { "type": "keyword" },
                "hostname": { "type": "keyword" },
                "ip": { "type": "ip" }
              }
            },
            "event": {
              "properties": {
                "category": { "type": "keyword" },
                "kind": { "type": "keyword" },
                "type": { "type": "keyword" },
                "outcome": { "type": "keyword" }
              }
            },
            "source": {
              "properties": {
                "ip": { "type": "ip" },
                "port": { "type": "integer" },
                "geo": {
                  "properties": {
                    "city_name": { "type": "keyword" },
                    "country_name": { "type": "keyword" },
                    "location": { "type": "geo_point" }
                  }
                }
              }
            },
            "destination": {
              "properties": {
                "ip": { "type": "ip" },
                "port": { "type": "integer" }
              }
            },
            "user": {
              "properties": {
                "name": { "type": "keyword" },
                "domain": { "type": "keyword" },
                "id": { "type": "keyword" }
              }
            },
            "process": {
              "properties": {
                "name": { "type": "keyword" },
                "pid": { "type": "long" },
                "parent": {
                  "properties": {
                    "name": { "type": "keyword" },
                    "pid": { "type": "long" }
                  }
                },
                "command_line": { "type": "text" }
              }
            },
            "tags": { "type": "keyword" },
            "labels": { "type": "object", "dynamic": true },
            "mitre": {
              "properties": {
                "tactic": { "type": "keyword" },
                "technique": { "type": "keyword" },
                "technique_id": { "type": "keyword" }
              }
            },
            "detection": {
              "properties": {
                "rule_id": { "type": "keyword" },
                "rule_name": { "type": "keyword" },
                "severity": { "type": "keyword" },
                "confidence": { "type": "float" }
              }
            },
            "label": { "type": "keyword" }
          }
        }
      },
      "priority": 100
    },
