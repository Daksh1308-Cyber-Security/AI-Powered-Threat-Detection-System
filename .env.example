# ===========================================
# AI-Powered Threat Detection System
# Environment Configuration
# ===========================================

# -------------------------------------------
# ELK Stack Version
# -------------------------------------------
ELK_VERSION=8.12.0

# -------------------------------------------
# Elasticsearch Configuration
# -------------------------------------------
# Heap size (set to 50% of available RAM, max 32GB)
ES_HEAP_SIZE=4g

# Ports
ES_PORT=9200
ES_TRANSPORT_PORT=9300

# -------------------------------------------
# Logstash Configuration
# -------------------------------------------
# Heap size (set to 50% of available RAM)
LS_HEAP_SIZE=2g

# Ports
LOGSTASH_BEATS_PORT=5044        # linux-syslog pipeline
LOGSTASH_BEATS_PORT_WINDOWS=5045
LOGSTASH_BEATS_PORT_AUTH=5046
LOGSTASH_BEATS_PORT_NETWORK=5047
LOGSTASH_MONITORING_PORT=9600
LOGSTASH_SYSLG_PORT=5514
LOGSTASH_SURICATA_PORT=5515

# -------------------------------------------
# Kibana Configuration
# -------------------------------------------
# Port
KIBANA_PORT=5601

# Encryption keys (generate with: openssl rand -hex 32)
KIBANA_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here
KIBANA_REPORTING_KEY=your-32-byte-hex-reporting-key-here

# -------------------------------------------
# Alert Triage Service
# -------------------------------------------
TRIAGE_PORT=8080

# -------------------------------------------
# ML Model Configuration
# -------------------------------------------
MODEL_UPDATE_INTERVAL=3600  # seconds
ANOMALY_THRESHOLD=0.7

# -------------------------------------------
# Lab Network Configuration
# -------------------------------------------
# Host-only network: 192.168.56.0/24
KALI_IP=192.168.56.10
UBUNTU_IP=192.168.56.20
WINDOWS_IP=192.168.56.30

# -------------------------------------------
# Attack Simulation Settings
# -------------------------------------------
ATTACK_DURATION=30m
ATTACK_INTENSITY=medium
ATTACK_LOG_PATH=/var/log/attack-simulation.log

# -------------------------------------------
# Detection Settings
# -------------------------------------------
SIGMA_RULES_PATH=./detection-rules/sigma/rules
YARA_RULES_PATH=./detection-rules/yara
ML_MODEL_PATH=./ml-model/models

# -------------------------------------------
# Logging
# -------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
